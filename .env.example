# Copy this file to .env (which git ignores) and fill in the keys you have.
# Never commit .env and never paste keys into chats or issues.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Direct TypeSafe access (waitlist); optional, OpenRouter is used for Jev by default.
TYPESAFE_API_KEY=
